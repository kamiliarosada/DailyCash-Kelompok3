<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilih Kategori"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/primary_brown"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false">

        <!-- Makan -->
        <LinearLayout
            android:id="@+id/cat_food"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_category_item">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/primary_brown"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Makan"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_main"/>
        </LinearLayout>

        <!-- Bensin -->
        <LinearLayout
            android:id="@+id/cat_transport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_category_item">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_directions"
                app:tint="@color/primary_brown"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bensin"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_main"/>
        </LinearLayout>

        <!-- Belanja -->
        <LinearLayout
            android:id="@+id/cat_shopping"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_category_item">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@color/primary_brown"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belanja"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_main"/>
        </LinearLayout>

        <!-- Hiburan -->
        <LinearLayout
            android:id="@+id/cat_entertainment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:layout_margin="4dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_category_item">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_slideshow"
                app:tint="@color/primary_brown"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hiburan"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_main"/>
        </LinearLayout>

        <!-- Kesehatan -->
        <LinearLayout
            android:id="@+id/cat_health"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:layout_margin="4dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_category_item">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="@color/primary_brown"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kesehatan"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_main"/>
        </LinearLayout>

        <!-- Lainnya -->
        <LinearLayout
            android:id="@+id/cat_others"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:layout_margin="4dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_category_item">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_help"
                app:tint="@color/primary_brown"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lainnya"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_main"/>
        </LinearLayout>

    </GridLayout>

</LinearLayout>
