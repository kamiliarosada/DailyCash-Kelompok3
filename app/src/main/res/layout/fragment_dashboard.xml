<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_brown"
        app:elevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp">

            <LinearLayout
                android:id="@+id/layout_title_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/tvFinancialStatus"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_wallet"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvRemainingBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnToggleBalance"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_view"
                        app:tint="@color/white"
                        android:contentDescription="@string/toggle_visibility" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvFinancialStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_status_safe"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/status_safe"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_sheet_white"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Primary Summary -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardIncome"
                    style="@style/ExtraRoundedCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/bg_income_card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/income_label"
                            android:textSize="10sp"
                            android:textColor="@color/text_income"
                            android:textStyle="bold"
                            android:textAllCaps="true"/>
                        <TextView
                            android:id="@+id/tvTotalIncome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 0"
                            android:textColor="@color/text_income"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:ellipsize="end"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardExpense"
                    style="@style/ExtraRoundedCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/bg_expense_card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/expense_label"
                            android:textSize="10sp"
                            android:textColor="@color/text_expense"
                            android:textStyle="bold"
                            android:textAllCaps="true"/>
                        <TextView
                            android:id="@+id/tvTotalExpense"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 0"
                            android:textColor="@color/text_expense"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:ellipsize="end"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFixed"
                style="@style/ExtraRoundedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/bg_fixed_card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fixed_label"
                            android:textSize="10sp"
                            android:textColor="@color/text_fixed"
                            android:textStyle="bold"
                            android:textAllCaps="true"/>
                        <TextView
                            android:id="@+id/tvTotalFixed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 0"
                            android:textColor="@color/text_fixed"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:ellipsize="end"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_manage"
                        app:tint="@color/text_fixed"
                        android:alpha="0.5"
                        android:contentDescription="@string/nav_fixed" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/budget_mgmt_title"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="6dp"
                android:textSize="16sp"
                android:textColor="@color/text_main"
                android:fontFamily="sans-serif-medium"/>

            <!-- Symmetrical Management Boxes (EQUAL SIZE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:weightSum="2">

                <com.google.android.material.card.MaterialCardView
                    style="@style/ExtraRoundedCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/budget_limit"
                            android:textSize="10sp"
                            android:textColor="@color/text_hint"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1"/>
                        <TextView
                            android:id="@+id/tvMonthlyBudget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 0"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/text_main"
                            android:layout_marginTop="8dp"
                            android:maxLines="1"
                            android:ellipsize="end"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/ExtraRoundedCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/daily_allowance"
                            android:textSize="10sp"
                            android:textColor="@color/text_hint"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1"/>
                        <TextView
                            android:id="@+id/tvDailyBudget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 0"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/primary_brown"
                            android:layout_marginTop="8dp"
                            android:maxLines="1"
                            android:ellipsize="end"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:id="@+id/tvRemainingDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sisa 0 hari lagi"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="12dp"
                android:textColor="@color/primary_light_brown"
                android:textSize="12sp"
                android:textStyle="italic"/>

            <!-- Quote Section -->

            <Button
                android:id="@+id/btnSetBudget"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/primary_brown"
                android:text="@string/set_budget_title"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                app:elevation="2dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/ExtraRoundedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="6dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/motivation_title"
                        android:textSize="12sp"
                        android:textColor="@color/primary_light_brown"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"/>
                    <TextView
                        android:id="@+id/tvQuote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/motivation_loading"
                        android:textColor="@color/text_main"
                        android:textSize="16sp"
                        android:textStyle="italic"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:fontFamily="serif"/>
                    <TextView
                        android:id="@+id/tvQuoteAuthor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
