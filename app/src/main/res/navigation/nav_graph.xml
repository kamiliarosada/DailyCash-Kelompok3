<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.dailycash.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboard_to_statistics"
            app:destination="@id/navigation_statistics" />
    </fragment>

    <fragment
        android:id="@+id/navigation_statistics"
        android:name="com.example.dailycash.ui.statistics.StatisticsFragment"
        android:label="Statistik"
        tools:layout="@layout/fragment_statistics" />

    <fragment
        android:id="@+id/navigation_fixed_expenses"
        android:name="com.example.dailycash.ui.fixedexpense.FixedExpenseFragment"
        android:label="Fixed Expenses"
        tools:layout="@layout/fragment_fixed_expense" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.dailycash.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/navigation_add_transaction"
        android:name="com.example.dailycash.ui.transaction.AddTransactionFragment"
        android:label="Add Transaction"
        tools:layout="@layout/fragment_add_transaction">
        <argument
            android:name="isIncome"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>
</navigation>
